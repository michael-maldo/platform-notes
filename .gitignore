
# ==========================================
# Docusaurus - Git Ignore
# ==========================================

# Dependencies
node_modules/

# Docusaurus generated files
.docusaurus/
build/

# Production / deployment outputs
dist/
.cache/
.temp/
tmp/
temp/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IDE / Editor
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Test coverage
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# Local backup files
*.bak
*.backup
*.orig

